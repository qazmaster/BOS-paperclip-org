{
  "schema_version": "0.1-v1.4.1",
  "name": "BOS Light Company Template for Paperclip",
  "note": "v1.4.1 doctrine package. Validate against current Paperclip companies.sh/import schema before use.",
  "mission": "Execute human missions through a Paperclip-native seven-division organizational intelligence layer.",
  "divisions": [
    {
      "id": "Div7.MissionControl",
      "title": "Mission Control / Strategy",
      "reports_to": null,
      "agent_profile": "agents/Div7_MissionControl/AGENTS.md",
      "vfp": "Accepted missions framed into strategic intent"
    },
    {
      "id": "Div1.HCO",
      "title": "Head Communication Office",
      "reports_to": "Div7.MissionControl",
      "agent_profile": "agents/Div1_HCO/AGENTS.md",
      "vfp": "Correct routing, dispatch and escalation"
    },
    {
      "id": "Div2.MasterPlanner",
      "title": "Shaping / Product Planning",
      "reports_to": "Div1.HCO",
      "agent_profile": "agents/Div2_MasterPlanner/AGENTS.md",
      "vfp": "Well-shaped work"
    },
    {
      "id": "Div3.Treasury",
      "title": "Treasury / Budget / Access",
      "reports_to": "Div1.HCO",
      "agent_profile": "agents/Div3_Treasury/AGENTS.md",
      "vfp": "Budget-fit and access-feasible work"
    },
    {
      "id": "Div4.Production",
      "title": "Production / Build / Delivery",
      "reports_to": "Div1.HCO",
      "agent_profile": "agents/Div4_Production/AGENTS.md",
      "vfp": "Completed accepted artifacts"
    },
    {
      "id": "Div5.QualificationsLibraryLearning",
      "title": "Qualifications / Library / Learning",
      "reports_to": "Div1.HCO",
      "agent_profile": "agents/Div5_QualificationsLibraryLearning/AGENTS.md",
      "vfp": "Verified, sanitized work"
    },
    {
      "id": "Div6.External",
      "title": "External / DMZ",
      "reports_to": "Div1.HCO",
      "agent_profile": "agents/Div6_External/AGENTS.md",
      "vfp": "External evidence collected and quarantined"
    }
  ],
  "routing_rules": {
    "high_level_mission": "Div7.MissionControl -> Div1.HCO",
    "backlog_shaping": "Div1.HCO -> Div2.MasterPlanner",
    "budget_capacity": "Div1.HCO -> Div3.Treasury",
    "implementation": "Div1.HCO -> Div4.Production",
    "qa_security_review": "Div1.HCO -> Div5.QualificationsLibraryLearning",
    "external_io_request": "Div1.HCO -> Div5.QualificationsLibraryLearning -> Div6.External",
    "complex_decision": "Div1.HCO -> Div7.MissionControl"
  },
  "rituals": [
    "daily_pulse",
    "weekly_review",
    "batch_approval_ritual"
  ],
  "bos_config": {
    "company_token_budget_ref": 100000,
    "bpi_cutline": 0.35,
    "betting_table_top_n": 7,
    "circuit_breaker_max_attempts": 3,
    "circuit_breaker_half_open_threshold": 2
  }
}
