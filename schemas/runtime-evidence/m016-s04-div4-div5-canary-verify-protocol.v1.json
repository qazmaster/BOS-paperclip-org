          "items": { "type": "string", "maxLength": 400, "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$" }
        }
      }
    },
    "launch_posture_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "issue_count", "issues"],
      "properties": {
        "frozen": { "type": "boolean" },
        "issue_count": { "type": "integer", "minimum": 0, "maximum": 32 },
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 400, "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$" }
        }
      }
    },
    "redaction_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "hit_count", "hits"],
      "properties": {
        "clean": { "type": "boolean" },
        "hit_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "hits": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "tail"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["uuid", "credential", "bearer", "sk_token", "tp_token", "xiaomi", "vendor_reuse", "raw_reasoning", "raw_body", "raw_result_json"]
              },
              "tail": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$" }
            }
          }
        }
      }
    },
    "tamper_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_count", "issues"],
      "properties": {
        "issue_count": { "type": "integer", "minimum": 0, "maximum": 32 },
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "verdict", "exit_code"],
            "properties": {
              "code": { "type": "string", "pattern": "^M16-S04-VERIFY-[A-Za-z0-9._-]+$" },
              "verdict": { "type": "string", "enum": ["PASS", "FAIL_CLOSED", "NOT_PROVEN"] },
              "exit_code": { "type": "integer", "minimum": 1, "maximum": 8 },
              "fixture_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$", "maxLength": 64 }
            }
          }
        }
      }
    },
    "classification_drift": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 400, "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$" }
    },
    "redaction_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_ids", "credentials", "xiaomi_endpoint_reuse", "synthetic_bos",
        "raw_reasoning", "raw_body", "raw_result_json_result",
        "vendor_reuse_strings", "bounded_digests_only", "redaction_bounds_loaded"
      ],
      "properties": {
        "full_ids": { "type": "boolean", "const": false },
        "credentials": { "type": "boolean", "const": false },
        "xiaomi_endpoint_reuse": { "type": "boolean", "const": false },
        "synthetic_bos": { "type": "boolean", "const": false },
        "raw_reasoning": { "type": "boolean", "const": false },
        "raw_body": { "type": "boolean", "const": false },
        "raw_result_json_result": { "type": "boolean", "const": false },
        "vendor_reuse_strings": { "type": "boolean", "const": false },
        "bounded_digests_only": { "type": "boolean", "const": true },
        "redaction_bounds_loaded": { "type": "boolean", "const": true }
      }
    },
    "embedded_classification_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestration", "evidence", "launch"],
      "properties": {
        "orchestration": { "type": "string", "enum": ["PASS", "PARTIAL", "NOT_PROVEN"] },
        "evidence": { "type": "string", "enum": ["PASS", "PARTIAL", "NOT_PROVEN"] },
        "launch": { "type": "string", "const": "PREPARATION_ONLY" }
      }
    },
    "replay_keys_match": { "type": "boolean" },
    "blockers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "reason"],
        "properties": {
          "code": { "type": "string", "pattern": "^M16-S04-VERIFY-[A-Za-z0-9._-]+$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$" },
          "source_ref": { "type": "string", "pattern": "^runtime-evidence/M016-S[0-9]{2}-[A-Za-z0-9._/-]+\\.json$", "maxLength": 256 }
        }
      }
    },
    "blocker_codes": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^M16-S04-VERIFY-[A-Za-z0-9._-]+$" }
    },
    "runner_status": { "type": "string", "enum": ["PASS", "FAIL_CLOSED", "NOT_PROVEN"] },
    "runner_exit_code": { "type": "integer", "minimum": 0, "maximum": 8 },
    "verdict_line": {
      "type": "string",
      "minLength": 18,
      "maxLength": 1024,
      "pattern": "^M16-S04-VERIFY\\s+verdict=[A-Z0-9_]+(\\s+exit=[0-9]+)?(\\s+[A-Za-z0-9_]+=[!-~]+)*$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "verify", "schema"],
      "properties": {
        "bundle": { "type": "string", "pattern": "^runtime-evidence/M016-S04-div4-div5-canary-bundle\\.json$" },
        "verify": { "type": "string", "pattern": "^runtime-evidence/M016-S04-div4-div5-canary-verify-protocol\\.json$" },
        "schema": { "type": "string", "pattern": "^schemas/runtime-evidence/m016-s04-div4-div5-canary-bundle\\.v1\\.json$" }
      }
    }
  }
}
