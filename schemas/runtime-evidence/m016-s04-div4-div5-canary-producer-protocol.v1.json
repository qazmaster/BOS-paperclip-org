{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gsd.local/schemas/runtime-evidence/m016-s04-div4-div5-canary-producer-protocol.v1.json",
  "title": "M016-S04 Div4 to Div5 Canary Producer Protocol v1",
  "description": "Producer-side protocol file emitted by the Div4 producer CLI (`produce_m016_s04_div4_div5_canary.js`) capturing line_class `M16-S04-CANARY`, canonical protocol `PROTOCOL-M16-S04-CANARY-V1`, sources loaded, role subset, drill subset, evidence_chain pre/post hashes, dual-replay status, gate initialisation, and paths. Producer protocol is informational; the Div5 independent validator MUST NOT trust it as evidence — it only cross-references the producer protocol to detect tampering or stub override of the canary bundle. No full UUIDs, no credentials, no absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "protocol_id",
    "protocol_kind",
    "milestone",
    "slice",
    "task",
    "generated",
    "line_class",
    "canonical_protocol",
    "bundle_id",
    "bundle_sha256",
    "bundle_path",
    "protocol_path",
    "producer_command",
    "role_subset",
    "drill_subset",
    "evidence_chain",
    "replay",
    "gates",
    "verdict",
    "blockers",
    "runner_status",
    "runner_exit_code",
    "verdict_line"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "https://gsd.local/schemas/runtime-evidence/m016-s04-div4-div5-canary-producer-protocol.v1.json"
    },
    "schema_version": { "type": "string", "const": "v1" },
    "protocol_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$" },
    "protocol_kind": { "type": "string", "const": "div4-to-div5-canary-producer-protocol" },
    "milestone": { "type": "string", "const": "M016-txa3vu" },
    "slice": { "type": "string", "const": "S04" },
    "task": { "type": "string", "enum": ["T03", "t03"] },
    "generated": { "type": "string", "format": "date-time" },
    "line_class": { "type": "string", "const": "M16-S04-CANARY" },
    "canonical_protocol": { "type": "string", "const": "PROTOCOL-M16-S04-CANARY-V1" },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$",
      "minLength": 3,
      "maxLength": 64
    },
    "bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundle_path": {
      "type": "string",
      "pattern": "^runtime-evidence/M016-S04-div4-div5-canary-bundle\\.json$"
    },
    "protocol_path": {
      "type": "string",
      "pattern": "^runtime-evidence/M016-S04-div4-div5-canary-producer-protocol\\.json$"
    },
    "schema_path": {
      "type": "string",
      "pattern": "^schemas/runtime-evidence/m016-s04-div4-div5-canary-bundle\\.v1\\.json$"
    },
    "producer_command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[A-Za-z0-9 .:;,_<>/\\-{}?&=%@]+$",
      "not": { "pattern": "(?:sk-|tp-|bearer\\s+[A-Za-z])" }
    },
    "role_subset": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^(Div[1-7]\\.(HCO|MasterPlanner|Treasury|Production|QualificationsLibraryLearning|External|MissionControl)|paperclip_health|hermes_environment|secret_posture|cost_snapshot|isolation_invariant|restore_drill|budget_stop_drill|failure_drill|redaction_posture_audit)$"
      }
    },
    "drill_subset": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "enum": ["restore-drill", "budget-stop-drill", "failure-drill"] }
    },
    "reference_time": { "type": "string", "format": "date-time" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force", "iterations"],
      "properties": {
        "force": { "type": "boolean" },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 16 },
        "reference_time": { "type": "string", "format": "date-time" }
      }
    },
    "sources_loaded": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^runtime-evidence/M016-S[0-9]{2}-[A-Za-z0-9._/-]+\\.json$",
        "maxLength": 256
      }
    },
    "evidence_chain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain_role", "source_ref", "pre_hash_sha256", "post_hash_sha256", "unchanged"],
        "properties": {
          "chain_role": {
            "type": "string",
            "enum": ["s02_baseline", "s03_pack", "canary_probe_run", "s03_verify_protocol", "s03_collect_protocol", "s03_input_inventory"]
          },
          "source_ref": {
            "type": "string",
            "pattern": "^runtime-evidence/M016-S[0-9]{2}-[A-Za-z0-9._/-]+\\.json$",
            "maxLength": 256
          },
          "pre_hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "post_hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "unchanged": { "type": "boolean", "const": true },
          "independence_group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,63}$"
          },
          "runner_status": {
            "type": "string",
            "enum": ["PASS", "FAIL_CLOSED", "NOT_PROVEN"]
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "first_run_provenance_hash", "second_run_provenance_hash", "match", "byte_identical"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 1, "maximum": 16 },
        "first_run_provenance_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "second_run_provenance_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "match": { "type": "boolean", "const": true },
        "byte_identical": { "type": "boolean", "const": true }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CG1 CANARY_PRODUCER_VALID",
        "CG2 CANARY_VALIDATOR_INDEPENDENT",
        "CG3 EVIDENCE_CHAIN_INTACT",
        "CG4 CORRELATION_CONTRACT_VALID",
        "CG5 REDACTION_SAFE",
        "CG6 S02_BASELINE_IMMUTABLE",
        "CG7 S03_PACK_IMMUTABLE",
        "CG8 DETERMINISTIC_REPLAY"
      ],
      "properties": {
        "CG1 CANARY_PRODUCER_VALID": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG2 CANARY_VALIDATOR_INDEPENDENT": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG3 EVIDENCE_CHAIN_INTACT": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG4 CORRELATION_CONTRACT_VALID": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG5 REDACTION_SAFE": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG6 S02_BASELINE_IMMUTABLE": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG7 S03_PACK_IMMUTABLE": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] },
        "CG8 DETERMINISTIC_REPLAY": { "type": "string", "enum": ["pass", "not_proven", "fail_closed"] }
      }
    },
    "canary_subset_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_records", "drill_records", "correlation_rows", "agent_run_to_probe_rows"],
      "properties": {
        "live_records": { "type": "integer", "minimum": 0, "maximum": 16 },
        "drill_records": { "type": "integer", "minimum": 0, "maximum": 8 },
        "correlation_rows": { "type": "integer", "minimum": 1, "maximum": 32 },
        "agent_run_to_probe_rows": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PRODUCED", "FAIL_CLOSED", "NOT_PROVEN"]
    },
    "blockers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "reason"],
        "properties": {
          "code": { "type": "string", "pattern": "^M16-S04-CANARY-[A-Za-z0-9._-]+$" },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[A-Za-z0-9 .:;,_<>/\\-]+$"
          },
          "source_ref": {
            "type": "string",
            "pattern": "^runtime-evidence/M016-S[0-9]{2}-[A-Za-z0-9._/-]+\\.json$",
            "maxLength": 256
          }
        }
      }
    },
    "runner_status": { "type": "integer", "minimum": 0, "maximum": 8 },
    "runner_exit_code": { "type": "integer", "minimum": 0, "maximum": 8 },
    "verdict_line": {
      "type": "string",
      "minLength": 18,
      "maxLength": 1024,
      "pattern": "^M16-S04-CANARY\\s+verdict=[A-Z0-9_]+(\\s+exit=[0-9]+)?(\\s+[A-Za-z0-9_]+=[!-~]+)*$"
    }
  },
  "allOf": [
    {
      "description": "FAIL_CLOSED verdict MUST surface a non-zero runner_status and runner_exit_code; PRODUCED verdict MUST keep them at zero.",
      "if": {
        "properties": {
          "verdict": { "const": "FAIL_CLOSED" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "runner_status": { "type": "integer", "minimum": 1, "maximum": 8 },
          "runner_exit_code": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    },
    {
      "description": "PRODUCED verdict MUST keep runner_status and runner_exit_code at zero.",
      "if": {
        "properties": {
          "verdict": { "const": "PRODUCED" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "runner_status": { "type": "integer", "enum": [0] },
          "runner_exit_code": { "type": "integer", "enum": [0] }
        }
      }
    }
  ]
}
}
