# BOS Light for Paperclip — Environment Variables
# Copy to .env and fill in values

# =============================================================================
# Required for live Paperclip API calls
# =============================================================================
PAPERCLIP_API_KEY=
PAPERCLIP_BASE_URL=https://paperclip.oysana.com
PAPERCLIP_COMPANY_ID=

# =============================================================================
# Required for Hermes Xiaomi execution (external dependency)
# =============================================================================
OPENAI_API_KEY=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# =============================================================================
# Optional: Git authentication (choose one method)
# =============================================================================
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GIT_SSH_KEY=/path/to/key

# =============================================================================
# Optional: Telegram notifications (not used in current codebase)
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# =============================================================================
# Optional: Paperclip web login (not used in API calls)
# =============================================================================
# PAPERCLIP_EMAIL=
# PAPERCLIP_PASSWORD=

# =============================================================================
# Optional: Probe script overrides (rarely needed)
# =============================================================================
# PAPERCLIP_PLUGIN_KEY=             # Falls back to manifest value
# PAPERCLIP_AUTH_HEADER=Authorization
# PAPERCLIP_API_KEY_ENV=PAPERCLIP_API_KEY
# PAPERCLIP_TIMEOUT_SECONDS=30
# PAPERCLIP_ISSUE_ID=               # For probe scripts
# PAPERCLIP_SANDBOX_COMPANY_ID=     # Fallback company ID
# PAPERCLIP_SANDBOX_ISSUE_ID=       # Fallback issue ID
